# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
quote_type = single

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# The only divergence from the framework's copy of this file, and it is not a choice:
# YAML forbids tab indentation, and this repository has a workflow file.
[*.{yml,yaml}]
indent_style = space
indent_size = 2
